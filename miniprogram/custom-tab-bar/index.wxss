.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -6rpx 24rpx rgba(22, 36, 72, 0.08);
  border-top: 1rpx solid rgba(22, 36, 72, 0.05);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 10rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8A94A6;
}

.tab-active .tab-text {
  color: #2F6FED;
  font-weight: 600;
}

/* 中央凸起扫码按钮 */
.tab-scan {
  position: relative;
}

.scan-btn {
  width: 96rpx;
  height: 96rpx;
  margin-top: -52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4C8DFF, #2F6FED);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(47, 111, 237, 0.38);
  border: 6rpx solid #ffffff;
  box-sizing: border-box;
}

.scan-icon {
  width: 46rpx;
  height: 46rpx;
}

.scan-text {
  color: #2F6FED;
  font-weight: 600;
}

.tab-scan:active .scan-btn {
  transform: scale(0.94);
}
