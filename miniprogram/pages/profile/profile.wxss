/* 我的页 */
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(140deg, #3B7BF5 0%, #2F6FED 55%, #1B4FD8 100%);
  color: #ffffff;
  border-radius: 28rpx;
  padding: 38rpx 34rpx;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 3rpx solid rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.user-info {
  margin-left: 26rpx;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
}

.user-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  opacity: 0.88;
}

.warn-text {
  color: var(--lz-red);
}

.small-text {
  font-size: 23rpx;
}

.logout-btn {
  margin-top: 6rpx;
}

/* 我的页卡片间距微调 */
.page .card {
  margin-top: 24rpx;
}

/* 额度卡 */
.balance-grid {
  display: flex;
  padding: 8rpx 0 4rpx;
}

.balance-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.balance-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--lz-text);
}

.num-blue { color: #2F6FED; }
.num-green { color: #17803D; }

.balance-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--lz-text-2);
}

.balance-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--lz-text-3);
}
