<view class="page">
  <view class="card user-card">
    <view class="avatar">{{nickname[0]}}</view>
    <view class="user-info">
      <view class="user-name">{{nickname}}</view>
      <view class="user-sub">{{roleText}} · {{username}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">账号信息</view>
    <view class="cell">
      <text class="cell-label">权限码数量</text>
      <text class="cell-value">{{permissionCount}}</text>
    </view>
    <view class="cell">
      <text class="cell-label">员工档案</text>
      <text class="cell-value" wx:if="{{employeeBound}}">已关联</text>
      <text class="cell-value warn-text" wx:else>未关联（无法打卡与查考勤）</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">后端服务</view>
    <view class="cell">
      <text class="cell-label">地址</text>
      <text class="cell-value small-text">{{baseUrl}}</text>
    </view>
    <view class="tip">当前连接阿里云函数计算线上后端（Supabase 云端库）。真机测试请用「真机调试」；正式发布需配置 ICP 备案的 HTTPS 域名。</view>
  </view>

  <view class="card">
    <button class="btn-danger logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>
