<view class="page">
  <!-- 筛选胶囊组 -->
  <view class="filter-chips">
    <view
      wx:for="{{filterLabels}}"
      wx:key="index"
      class="chip {{filterIndex === index ? 'chip-on' : ''}}"
      data-index="{{index}}"
      bindtap="onFilterTap"
    >{{item}}</view>
    <view class="total-text">共 {{total}} 条</view>
  </view>

  <!-- 记录列表 -->
  <view class="record-list" wx:if="{{items.length > 0}}">
    <view class="record-card" wx:for="{{items}}" wx:key="id">
      <view class="rc-left">
        <view class="rc-type">{{item.typeText}}</view>
        <view class="rc-meta">{{item.timeText}} · {{item.placeName}}</view>
      </view>
      <view class="rc-right">
        <view class="tag {{item.tagCls}}">{{item.resultText}}</view>
        <view class="rc-source">{{item.sourceText}}</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{items.length === 0 && !loading}}">
    <view class="empty-icon">勤</view>
    <view>暂无考勤记录</view>
    <view class="empty-sub">去首页扫码打卡，或检查筛选条件</view>
  </view>

  <view class="load-more" wx:if="{{hasMore && items.length > 0}}">上拉加载更多…</view>
  <view class="load-more" wx:if="{{!hasMore && items.length > 0}}">没有更多了</view>
</view>
