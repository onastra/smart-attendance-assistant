.seg {
  display: flex;
  background: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #5B6472;
}

.seg-active {
  background: #2F6FED;
  color: #ffffff;
  font-weight: 600;
}

.app-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F0F2F6;
}

.app-item:last-child {
  border-bottom: none;
}

.app-line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.app-type {
  font-size: 30rpx;
  font-weight: 700;
}

.type-leave { color: #2F6FED; }
.type-overtime { color: #B25E09; }

.app-line2 {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5B6472;
}

.app-reason {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #1F2937;
  line-height: 1.6;
}

.app-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8A94A6;
}

.app-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.mini-btn {
  margin: 0;
}

.empty-btn {
  margin-top: 24rpx;
  display: inline-block;
}

.loading-more {
  text-align: center;
  color: #A5ADBB;
  font-size: 24rpx;
  padding: 24rpx 0;
}
