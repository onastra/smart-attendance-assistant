<view class="page">
  <view class="hero">
    <view class="logo">联</view>
    <view class="title">联智考勤</view>
    <view class="subtitle">企业级 AI Agent 智能考勤与业务助手</view>
  </view>

  <view class="card">
    <view class="form-item">
      <text class="form-label">账号</text>
      <input class="form-input" placeholder="请输入账号" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="form-item">
      <text class="form-label">口令</text>
      <input class="form-input" password placeholder="请输入口令" value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <button class="btn-primary login-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="doLogin">登 录</button>
  </view>
</view>
