<view class="page">
  <!-- 打卡入口：直扫。打卡类型由二维码签发时指定，员工端不提供选择 -->
  <view class="card">
    <view class="card-title">扫码打卡</view>
    <view class="tip type-tip">打卡类型（上班 / 下班 / 外勤）由管理员签发二维码时指定，扫码后自动按码上的类型打卡。</view>
    <view class="scan-big" bindtap="scanAndCheckin">
      <view class="scan-big-icon">
        <image class="scan-big-img" src="/images/scan-white.png" mode="aspectFit" />
      </view>
      <view class="scan-big-text">点 击 扫 码</view>
    </view>
    <view class="tip scan-tip">扫码后进入确认页，核对场所与围栏信息再提交。</view>
  </view>

  <!-- 手动输入兜底 -->
  <view class="card">
    <view class="card-title">手动输入（兜底）</view>
    <view class="tip">摄像头不可用或二维码破损时，把管理员发布的二维码内容粘贴到这里，校验链与扫码完全一致。</view>
    <textarea class="form-textarea manual-area" placeholder="粘贴二维码原文" value="{{manualContent}}" bindinput="onManualInput" maxlength="-1" />
    <button class="btn-plain manual-btn" bindtap="submitManual">去确认页</button>
  </view>

  <view class="tip checkin-foot" bindtap="goRecords">查看我的考勤 ›</view>
</view>
