.page {
  padding-bottom: 160rpx;
}

/* 打卡类型胶囊 */
.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.type-pill {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: #F1F4FA;
  color: var(--lz-text-2);
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.type-pill-on {
  background: #E9F0FE;
  color: var(--lz-primary);
  border-color: rgba(47, 111, 237, 0.55);
  font-weight: 600;
}

.type-tip {
  margin-bottom: 6rpx;
}

/* 大扫码按钮 */
.scan-big {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
}

.scan-big:active .scan-big-icon {
  transform: scale(0.94);
}

.scan-big-icon {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4C8DFF, #2F6FED);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 34rpx rgba(47, 111, 237, 0.38);
  transition: transform 0.12s;
}

.scan-big-img {
  width: 88rpx;
  height: 88rpx;
}

.scan-big-text {
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--lz-primary);
}

.scan-tip {
  text-align: center;
  margin-top: 8rpx;
}

.manual-area {
  margin-top: 18rpx;
}

.manual-btn {
  margin-top: 24rpx;
}

.checkin-foot {
  text-align: center;
  margin-top: 30rpx;
  color: var(--lz-primary);
}
