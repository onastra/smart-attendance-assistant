.page {
  padding-bottom: 160rpx;
}

.type-row {
  margin-bottom: 24rpx;
}

/* 结果卡 */
.result-card {
  margin: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(22, 36, 72, 0.06);
  border-top: 8rpx solid #34C077;
}

.result-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.result-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: #34C077;
}

.result-ok .result-dot { background: #34C077; }
.result-idem .result-dot { background: #E07A18; }

.result-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--lz-text);
}

.result-link {
  margin-top: 20rpx;
  text-align: center;
  color: var(--lz-primary);
  font-size: 27rpx;
  font-weight: 500;
}

/* 大扫码按钮 */
.scan-big {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
}

.scan-big:active .scan-big-icon {
  transform: scale(0.94);
}

.scan-big-icon {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4C8DFF, #2F6FED);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 34rpx rgba(47, 111, 237, 0.38);
  transition: transform 0.12s;
}

.scan-big-img {
  width: 88rpx;
  height: 88rpx;
}

.scan-big-text {
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--lz-primary);
}

.scan-tip {
  text-align: center;
  margin-top: 8rpx;
}

.manual-area {
  margin-top: 18rpx;
}

.manual-btn {
  margin-top: 24rpx;
}
