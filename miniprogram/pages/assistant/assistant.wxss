.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--lz-bg);
}

/* 顶部状态条 */
.ai-status {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid var(--lz-line);
  font-size: 23rpx;
  color: var(--lz-text-2);
}

.ai-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.ai-dot-on { background: #34C077; box-shadow: 0 0 8rpx rgba(52, 192, 119, 0.7); }
.ai-dot-off { background: #C62A2F; }

.ai-clear {
  margin-left: auto;
  color: var(--lz-primary);
  font-size: 24rpx;
  padding: 4rpx 16rpx;
}

/* 消息区 */
.chat-scroll {
  flex: 1;
  overflow: hidden;
  padding-top: 20rpx;
}

.row {
  display: flex;
  margin: 18rpx 28rpx;
}

.row-user { justify-content: flex-end; }
.row-ai { justify-content: flex-start; }

.ai-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #4C8DFF, #2F6FED);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.bubble {
  max-width: 74%;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  font-size: 29rpx;
  line-height: 1.65;
  word-break: break-all;
}

.bubble-user {
  background: linear-gradient(135deg, #4C8DFF, #2F6FED);
  color: #ffffff;
  border-top-right-radius: 8rpx;
  box-shadow: 0 6rpx 16rpx rgba(47, 111, 237, 0.25);
}

.bubble-ai {
  background: #ffffff;
  color: var(--lz-text);
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(22, 36, 72, 0.06);
}

.msg-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.grounded {
  font-size: 20rpx;
  color: #17803D;
  background: #E8F7EE;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.grounded-no {
  color: #B25E09;
  background: #FDF1E3;
}

.latency {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--lz-text-3);
}

.sources {
  margin-top: 14rpx;
  border-top: 1rpx dashed var(--lz-line);
  padding-top: 14rpx;
}

.source-item {
  margin-bottom: 10rpx;
}

.source-title {
  font-size: 22rpx;
  color: var(--lz-primary);
  font-weight: 500;
}

.source-section {
  font-size: 20rpx;
  color: var(--lz-text-3);
  margin-top: 2rpx;
}

.chat-pad-bottom {
  height: 30rpx;
}

/* 欢迎建议 */
.suggest {
  margin: 20rpx 28rpx 0 108rpx;
}

.suggest-title {
  font-size: 24rpx;
  color: var(--lz-text-3);
  margin-bottom: 14rpx;
}

.suggest-item {
  display: inline-block;
  background: #ffffff;
  border: 2rpx solid rgba(47, 111, 237, 0.25);
  color: var(--lz-primary);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 25rpx;
  margin: 0 14rpx 14rpx 0;
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom) + 110rpx);
  background: #ffffff;
  border-top: 1rpx solid var(--lz-line);
}

.chat-input {
  flex: 1;
  background: #F4F6FB;
  border-radius: 999rpx;
  padding: 18rpx 30rpx;
  font-size: 29rpx;
}

.send-btn {
  margin-left: 18rpx;
  background: linear-gradient(135deg, #4C8DFF, #2F6FED);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 0 38rpx;
  line-height: 76rpx;
}

.send-btn-idle {
  background: #A9C2F7;
}
