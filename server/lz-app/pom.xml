<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lianzhi.attendance</groupId>
        <artifactId>lianzhi-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lz-app</artifactId>
    <name>lz-app</name>
    <description>启动模块：聚合所有业务模块，唯一可执行 JAR 产物</description>

    <dependencies>
        <dependency>
            <groupId>com.lianzhi.attendance</groupId>
            <artifactId>lz-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lianzhi.attendance</groupId>
            <artifactId>lz-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lianzhi.attendance</groupId>
            <artifactId>lz-place</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lianzhi.attendance</groupId>
            <artifactId>lz-attendance</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lianzhi.attendance</groupId>
            <artifactId>lz-approval</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lianzhi.attendance</groupId>
            <artifactId>lz-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lianzhi.attendance</groupId>
            <artifactId>lz-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lianzhi.attendance</groupId>
            <artifactId>lz-face</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lianzhi.attendance</groupId>
            <artifactId>lz-job</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>lz-app</finalName>
        <!-- Maven 默认会复制 src/main/resources 下的全部文件。这里显式排除 *.bak：
             改本地配置时习惯性留一个 .bak 备份，而它可能含明文口令（MySQL/Redis/JWT 等），
             一旦被打进 BOOT-INF/classes 就会随 jar 一起外泄。
             2026-10-27 实测踩过：application-local.yml.mysql.bak 被打包进 lz-app.jar。
             注意 directory/filtering 必须显式写出，否则会覆盖 Maven 的默认资源行为。 -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/*.bak</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
