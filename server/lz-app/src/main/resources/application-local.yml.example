# 本地私密配置模板：复制为 application-local.yml 后填写，该文件已被 .gitignore 忽略
# 使用方式：启动时加 --spring.profiles.active=local，或直接设置同名环境变量（推荐）

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/lianzhi?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your_mysql_password
  data:
    redis:
      # 本机 Redis（Windows 服务 redis-lianzhi，见 docs/deployment.md）。
      # ⚠️ 2026-10-27 教训：本段此前不在模板里，有人照模板重建配置时把
      # Redis/缓存段丢了，导致缓存静默降级为 Noop（health 里 cache.enabled=false）。
      # 没装 Redis 就把下面整段连同 lz.cache 一起删掉，CacheService 会走 Noop 不报错。
      host: 127.0.0.1
      port: 6379
      password: your_redis_password_here

lz:
  # Redis 缓存开关：true=RedisCacheService（命中走缓存），false/缺省=NoopCacheService（直查库）
  # Redis 停机时自动降级直查（WARN 日志），接口不会失败
  cache:
    enabled: true

  security:
    jwt:
      # 至少 32 字节；可用 openssl rand -base64 32 生成
      secret: your_jwt_secret_at_least_32_bytes_long

  # LLM 配置（如使用硅基流动 SiliconFlow，填入自己的 API Key）
  # 注意：必须嵌套在 lz: 之下，配置前缀是 lz.llm.*
  llm:
    enabled: true
    api-key: your_llm_api_key_here
    base-url: https://api.siliconflow.cn/v1
    model: Qwen/Qwen2.5-7B-Instruct
    # 语义检索（向量嵌入），复用上面的 api-key / base-url
    embedding:
      enabled: true
      model: BAAI/bge-large-zh-v1.5

  # 地图选址（高德开放平台 Web端 JS API）。不配或留空 = 未接入，坐标手动录入
  # Key + 安全密钥在 https://console.amap.com 应用管理里查看；
  # ⚠️ 与 LLM Key 同理：只写在本文件（已 gitignore），绝不提交进仓库。
  # 建议在高德控制台为该 Key 配置域名白名单（开发期 localhost:5173）。
  map:
    provider: amap
    api-key: your_amap_jsapi_key_here
    security-code: your_amap_security_jscode_here