<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lianzhi.attendance</groupId>
        <artifactId>lianzhi-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lz-face</artifactId>
    <name>lz-face</name>
    <description>模块 G：人脸识别服务接口与适配层（默认使用明确标注的模拟实现，保留真实 SDK 接入点）</description>

    <dependencies>
        <dependency>
            <groupId>com.lianzhi.attendance</groupId>
            <artifactId>lz-framework</artifactId>
        </dependency>

        <!-- 虹软 ArcFace SDK（V3.0 Windows x64 Java）。
             不发布在 Maven 中央仓库，首次构建前需本地安装一次：
               cd server/libs/arcface/libs
               mvn install:install-file -Dfile=arcsoft-sdk-face-3.0.0.0.jar \
                 -DgroupId=com.arcsoft -DartifactId=arcsoft-sdk-face \
                 -Dversion=3.0.0.0 -Dpackaging=jar
             该 jar 同时被 lz-app 打进可执行包（provider=arcsoft 时运行期必需）。
             原生库（libs/WIN64/*.dll）不打进 jar，由 lz.face.sdk-lib-path 指定目录加载。 -->
        <dependency>
            <groupId>com.arcsoft</groupId>
            <artifactId>arcsoft-sdk-face</artifactId>
            <version>3.0.0.0</version>
        </dependency>
    </dependencies>
</project>
