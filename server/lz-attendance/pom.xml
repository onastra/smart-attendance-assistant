<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lianzhi.attendance</groupId>
        <artifactId>lianzhi-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lz-attendance</artifactId>
    <name>lz-attendance</name>
    <description>模块 C/D：二维码、H5 打卡、考勤记录与统计看板（核心链路）</description>

    <dependencies>
        <dependency>
            <groupId>com.lianzhi.attendance</groupId>
            <artifactId>lz-framework</artifactId>
        </dependency>

        <!-- 二维码编解码（ZXing）。
             core 负责编码规则，javase 提供 BufferedImage 渲染，
             二者组合即可在服务端直接输出 PNG，不需要再引入前端生成库。 -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.2.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.2.0</version>
        </dependency>
    </dependencies>
</project>
